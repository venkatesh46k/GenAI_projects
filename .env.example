# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# --- Active LLM Provider (agents/llm.py) ---
ACTIVE_PROVIDER=ollama              # ollama | groq | cloudflare | openai | anthropic
# JUDGE_PROVIDER=anthropic          # optional: DeepEval judge provider (defaults to ACTIVE_PROVIDER)

# --- Groq ---
GROQ_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-120b

# --- Cloudflare Workers AI ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_TEXT_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_TEXT_MODEL=claude-sonnet-4-6

# --- Ollama (local) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_TEXT_MODEL=llama3.1:8b
# OLLAMA_NUM_GPU=0                  # force CPU-only if the CUDA runner crashes

# --- Services ---
FASTAPI_BASE_URL=http://localhost:8000
CHROMA_PERSIST_DIR=rag/chroma_db
LOG_LEVEL=INFO
